# Copy to .env and fill in. CRA only exposes REACT_APP_* vars to the browser.
# WARNING: anything here is bundled into the client and visible to users.
# For production, proxy these calls through a backend instead of shipping keys.

# Infura IPFS (https://app.infura.io) -- ROTATE the old leaked credentials first
REACT_APP_INFURA_IPFS_PROJECT_ID=
REACT_APP_INFURA_IPFS_SECRET=

# Azure Form Recognizer -- ROTATE the old leaked key first
REACT_APP_FR_KEY=
REACT_APP_FR_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/
